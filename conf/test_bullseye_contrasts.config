/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Bullseye tests (contrasts file)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a pipeline test with Bullseye
    editing-site detection using an explicit contrasts CSV (bullseye_contrasts) instead
    of the group-based comparison mode.

    Use as follows:
        nextflow run nf-core/dartseq -profile test_bullseye_contrasts,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Bullseye contrasts test profile'
    config_profile_description = 'DART-seq test dataset with STAR alignment and Bullseye editing-site detection (explicit contrasts file)'

    input  = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/samplesheet_4samples.csv"

    trimmer        = 'fastp'
    aligner        = 'star'
    skip_alignment = false

    skip_bullseye          = false
    annotation_reFlat_file = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/bullseye.test.refFlat"
    bullseye_contrasts     = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/contrasts_test.csv"

    bullseye_parse_min_coverage   = 1
    bullseye_edited_min_coverage  = 1
    bullseye_control_min_coverage = 1
    bullseye_replicates_min       = 1
    bullseye_min_mut              = 1
    bullseye_quant_coverage       = 1

    star_index = null
    fasta      = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genome.fa"
    gtf        = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genes.gtf"
}
