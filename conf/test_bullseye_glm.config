/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Bullseye GLM tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a pipeline test with Bullseye
    editing-site detection, RAC filtering, site gathering, and the GLM step against the
    gathered coverage/mutation matrices.

    Use as follows:
        nextflow run nf-core/dartseq -profile test_bullseye_glm,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Bullseye GLM test profile'
    config_profile_description = 'DART-seq test dataset with Bullseye editing-site detection through the GLM step'

    input  = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/samplesheet_4samples.csv"

    trimmer        = 'fastp'
    aligner        = 'star'
    skip_alignment = false

    skip_bullseye          = false
    annotation_reFlat_file = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/bullseye.test.refFlat"
    bullseye_control_group = 'control'

    bullseye_parse_min_coverage   = 1
    bullseye_min_edit             = 0
    bullseye_max_edit             = 100
    bullseye_edit_fold_threshold  = 1
    bullseye_min_edit_sites       = 1
    bullseye_edited_min_coverage  = 1
    bullseye_control_min_coverage = 1
    bullseye_replicates_min       = 1
    bullseye_min_mut              = 1
    bullseye_quant_coverage       = 1

    // Neither the RAC (3nt [A/G]AC) nor AC (2nt AC) motif filters are needed ahead
    // of the GLM step for this data: this tiny synthetic dataset's real detected
    // sites aren't in canonical AC context, so enforcing it here would leave
    // GATHER_SITES/BULLSEYE_R_GLM with zero rows to work with. Skipping both means
    // they consume every candidate site instead (still real detected sites, just
    // not filtered down to the canonical motif).
    skip_bullseye_racfilter = true
    skip_bullseye_acfilter  = true

    skip_bullseye_gather_sites = false
    bullseye_gather_score      = true
    bullseye_gather_coverage   = true
    bullseye_gather_mutations  = true

    skip_bullseye_glm    = false
    bullseye_glm_mock    = false
    // production default (10) filters out every site at this tiny test dataset's read depth
    bullseye_glm_min_cov = 1
    // Local, not test-datasets: this file's `sample` column has to match this exact
    // test's gathered coverage/mut columns 1:1 (confirmed from a real run:
    // "A04.bullseye.RAC", "E01.bullseye.RAC" - the RAC-filtered edited-sample names),
    // so it's meaningless outside this specific combination of settings and doesn't
    // belong in test-datasets as a general-purpose fixture.
    bullseye_glm_observations = "${projectDir}/tests/bullseye_glm_observations.tsv"

    star_index = null
    fasta      = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genome.fa"
    gtf        = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genes.gtf"
}
