/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the Bullseye GLM from matrices
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Starts from per-site coverage/mutation matrices (no FASTQs, no --input) and runs
    only the Bullseye beta-binomial GLM: real METTL3 DART-seq data, chr19, 3 wt vs 3 kd.

    Use as follows:
        nextflow run nf-core/dartseq -profile test_bullseye_glm_matrix,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Bullseye GLM matrix test profile'
    config_profile_description = 'Bullseye GLM on real chr19 coverage/mutation matrices (3 wt vs 3 kd)'

    bullseye_glm_coverage     = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/glm/coverage.txt"
    bullseye_glm_mut          = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/glm/mut.txt"
    bullseye_glm_observations = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/glm/observations.tsv"
    bullseye_glm_design       = '~group'
}
