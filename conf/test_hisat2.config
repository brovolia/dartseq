/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running HISAT2 alignment tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a pipeline test with HISAT2 alignment.

    Use as follows:
        nextflow run nf-core/dartseq -profile test_hisat2,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'HISAT2 alignment test profile'
    config_profile_description = 'DART-seq test dataset with HISAT2 alignment'

    input  = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/samplesheet_4samples.csv"

    trimmer        = 'fastp'
    aligner        = 'hisat2'
    skip_alignment = false
    skip_bullseye  = true

    hisat2_index       = null
    hisat2_splicesites = null
    fasta              = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genome.fa"
    gtf                = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genes.gtf"
}
