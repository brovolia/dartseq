/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running STAR alignment tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a pipeline test with STAR alignment.

    Use as follows:
        nextflow run nf-core/dartseq -profile test_star,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'STAR alignment test profile'
    config_profile_description = 'DART-seq test dataset with STAR alignment'

    input  = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/samplesheet_4samples.csv"

    trimmer        = 'fastp'
    aligner        = 'star'
    skip_alignment = false
    skip_bullseye  = true

    star_index = null
    fasta      = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genome.fa"
    gtf        = "${params.pipelines_testdata_base_path}dartseq/data/dartseq/reference/genes.gtf"
    genome     = null
}
