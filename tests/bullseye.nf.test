nextflow_pipeline {

    name "Bullseye test"
    script "../main.nf"
    tag "pipeline_bullseye"
    // Also runnable directly: nextflow run . -profile docker,test_bullseye
    // (the second test below corresponds to -profile docker,test_bullseye_contrasts;
    // a suite can only declare one profile here, so only the first is wired up).
    // nf-test 0.9.5: this suite-level profile is not reliably applied to
    // nextflow_pipeline tests (see bacmodel/tests/macsyfinder.nf.test for a
    // confirmed case on nf-test 0.9.3), so the params below are kept inline
    // as the source of truth for the actual test run.
    profile "test_bullseye"

    test("Bullseye on STAR alignment output") {

        when {
            params {
                outdir = "$outputDir"
                // input comes from conf/test.config (via the "test" profile).
                // Can't reference params.pipelines_testdata_base_path here - this
                // params{} block is evaluated by nf-test itself to build the
                // overrides JSON, before Nextflow has resolved anything from
                // nextflow.config, so it would silently be null.

                trimmer        = 'fastp'
                aligner        = 'star'
                skip_alignment = false

                skip_bullseye            = false
                annotation_reFlat_file   = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/bullseye.test.refFlat'
                bullseye_control_group   = 'control'

                bullseye_parse_min_coverage   = 1
                bullseye_min_edit             = 0
                bullseye_max_edit             = 100
                bullseye_edit_fold_threshold  = 1
                bullseye_min_edit_sites       = 1
                bullseye_edited_min_coverage  = 1
                bullseye_control_min_coverage = 1
                bullseye_replicates_min       = 1
                bullseye_min_mut              = 1
                bullseye_quant_coverage       = 1

                star_index = null
                fasta      = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genome.fa'
                gtf        = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genes.gtf'
            }
        }

        then {
            def a04VsA03 = file("$outputDir/bullseye/A04/A04.vs.A03.default.bed")
            def e01VsA03 = file("$outputDir/bullseye/E01/E01.vs.A03.default.bed")

            // BULLSEYE_ACFILTER's AC.counts.tsv - excluded from the content-hash
            // snapshot (its total_sites/ac_strict_sites can vary run-to-run with
            // real data), but its shape (2 columns, ac_strict_sites <= total_sites)
            // is always guaranteed and worth asserting.
            def acCountsChecks = ['A04', 'E01'].collect { sample ->
                { ->
                    def lines = file("$outputDir/bullseye/${sample}/${sample}.bullseye.AC.counts.tsv").readLines()
                    assert lines.size() == 2 : "${sample}: expected header + 1 data row"
                    assert lines[0] == 'total_sites\tac_strict_sites'
                    def (total, acStrict) = lines[1].tokenize('\t')*.toInteger()
                    assert total >= 0 && acStrict >= 0
                    assert acStrict <= total : "${sample}: ac_strict_sites (${acStrict}) exceeds total_sites (${total})"
                }
            }

            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'star/star/Log.out'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // bullseye/*/*.bed excluded: real editing-site detection is data-dependent -
            // a given sample can legitimately have zero sites (e.g. none pass the strict
            // AC-motif filter, or none are detected at all against a given control) in
            // this tiny synthetic test dataset. That's not a pipeline bug, so those files
            // are allowed to be empty here; their shape is still checked where meaningful
            // (see acCountsChecks above).
            def emptyFileChecks = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, ignore: ['bullseye/*/*.bed'])
                .collect { f -> { -> assert f.size() > 0 : "Empty output file: ${f}" } }
            assertAll(
                [
                    { assert workflow.success },
                    { assert a04VsA03.exists() },
                    { assert a04VsA03.readLines().size() > 1 },
                    { assert e01VsA03.exists() },
                    { assert snapshot(
                        // Number of successful tasks
                        workflow.trace.succeeded().size(),
                        // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                        removeNextflowVersion("$outputDir/pipeline_info/nf_core_dartseq_software_mqc_versions.yml"),
                        // All stable path names, with a relative path
                        stable_name,
                        // All files with stable contents
                        stable_path
                    ).match() }
                ] + acCountsChecks + emptyFileChecks as Closure[]
            )
        }
    }

    test("Bullseye with contrasts file") {
        // Corresponds to -profile docker,test_bullseye_contrasts (see conf/test_bullseye_contrasts.config).

        when {
            params {
                outdir = "$outputDir"
                // input comes from conf/test.config (via the "test" profile).
                // Can't reference params.pipelines_testdata_base_path here - this
                // params{} block is evaluated by nf-test itself to build the
                // overrides JSON, before Nextflow has resolved anything from
                // nextflow.config, so it would silently be null.

                trimmer        = 'fastp'
                aligner        = 'star'
                skip_alignment = false

                skip_bullseye                = false
                annotation_reFlat_file       = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/bullseye.test.refFlat'
                bullseye_contrasts           = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/contrasts_test.csv'

                bullseye_parse_min_coverage   = 1
                bullseye_edited_min_coverage  = 1
                bullseye_control_min_coverage = 1
                bullseye_replicates_min       = 1
                bullseye_min_mut              = 1
                bullseye_quant_coverage       = 1

                star_index = null
                fasta      = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genome.fa'
                gtf        = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genes.gtf'
            }
        }

        then {
            def a04VsA03 = file("$outputDir/bullseye/A04/A04.vs.A03.test_contrast.bed")
            def e01VsA03 = file("$outputDir/bullseye/E01/E01.vs.A03.test_contrast.bed")

            // BULLSEYE_ACFILTER's AC.counts.tsv - excluded from the content-hash
            // snapshot (its total_sites/ac_strict_sites can vary run-to-run with
            // real data), but its shape (2 columns, ac_strict_sites <= total_sites)
            // is always guaranteed and worth asserting.
            def acCountsChecks = ['A04', 'E01'].collect { sample ->
                { ->
                    def lines = file("$outputDir/bullseye/${sample}/${sample}.bullseye.AC.counts.tsv").readLines()
                    assert lines.size() == 2 : "${sample}: expected header + 1 data row"
                    assert lines[0] == 'total_sites\tac_strict_sites'
                    def (total, acStrict) = lines[1].tokenize('\t')*.toInteger()
                    assert total >= 0 && acStrict >= 0
                    assert acStrict <= total : "${sample}: ac_strict_sites (${acStrict}) exceeds total_sites (${total})"
                }
            }

            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'star/star/Log.out'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Every file produced, content-stable or not - .nftignore only excludes
            // files from the content-hash snapshot (unstable content, e.g. embedded
            // timestamps/tool versions), it doesn't mean they shouldn't be checked
            // at all: catch truncated/empty writes that a hash exclusion would miss.
            // bullseye/*/*.bed excluded: real editing-site detection is data-dependent -
            // a given sample can legitimately have zero sites (e.g. none pass the strict
            // AC-motif filter, or none are detected at all against a given control) in
            // this tiny synthetic test dataset. That's not a pipeline bug, so those files
            // are allowed to be empty here; their shape is still checked where meaningful
            // (see acCountsChecks above).
            def emptyFileChecks = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, ignore: ['bullseye/*/*.bed'])
                .collect { f -> { -> assert f.size() > 0 : "Empty output file: ${f}" } }
            assertAll(
                [
                    { assert workflow.success },
                    { assert a04VsA03.exists() },
                    { assert a04VsA03.readLines().size() > 1 },
                    { assert e01VsA03.exists() },
                    { assert snapshot(
                        // Number of successful tasks
                        workflow.trace.succeeded().size(),
                        // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                        removeNextflowVersion("$outputDir/pipeline_info/nf_core_dartseq_software_mqc_versions.yml"),
                        // All stable path names, with a relative path
                        stable_name,
                        // All files with stable contents
                        stable_path
                    ).match() }
                ] + acCountsChecks + emptyFileChecks as Closure[]
            )
        }
    }
}
