nextflow_pipeline {

    name "Bullseye GLM test"
    script "../main.nf"
    tag "pipeline_bullseye_glm"
    // Also runnable directly: nextflow run . -profile docker,test_bullseye_glm
    // nf-test 0.9.5: this suite-level profile is not reliably applied to
    // nextflow_pipeline tests (see bacmodel/tests/macsyfinder.nf.test for a
    // confirmed case on nf-test 0.9.3), so the params below are kept inline
    // as the source of truth for the actual test run.
    profile "test_bullseye_glm"

    test("Bullseye GLM on gathered coverage/mutation matrices") {

        when {
            params {
                outdir = "$outputDir"
                // input comes from conf/test.config (via the "test" profile).
                // Can't reference params.pipelines_testdata_base_path here - this
                // params{} block is evaluated by nf-test itself to build the
                // overrides JSON, before Nextflow has resolved anything from
                // nextflow.config, so it would silently be null.

                trimmer        = 'fastp'
                aligner        = 'star'
                skip_alignment = false

                skip_bullseye            = false
                annotation_reFlat_file   = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/bullseye.test.refFlat'
                bullseye_control_group   = 'control'

                bullseye_parse_min_coverage   = 1
                bullseye_min_edit             = 0
                bullseye_max_edit             = 100
                bullseye_edit_fold_threshold  = 1
                bullseye_min_edit_sites       = 1
                bullseye_edited_min_coverage  = 1
                bullseye_control_min_coverage = 1
                bullseye_replicates_min       = 1
                bullseye_min_mut              = 1
                bullseye_quant_coverage       = 1

                // Neither the RAC (3nt [A/G]AC) nor AC (2nt AC) motif filters are needed
                // ahead of the GLM step for this data: this tiny synthetic dataset's real
                // detected sites aren't in canonical AC context, so enforcing it here would
                // leave GATHER_SITES/BULLSEYE_R_GLM with zero rows to work with. Skipping
                // both means they consume every candidate site instead (still real
                // detected sites, just not filtered down to the canonical motif).
                skip_bullseye_racfilter = true
                skip_bullseye_acfilter  = true

                skip_bullseye_gather_sites  = false
                bullseye_gather_score       = true
                bullseye_gather_coverage    = true
                bullseye_gather_mutations   = true

                // The one thing this test adds on top of bullseye_postprocess.nf.test:
                // actually run the GLM step against the gathered coverage/mut matrices.
                skip_bullseye_glm      = false
                bullseye_glm_mock      = false
                bullseye_glm_min_cov   = 1  // production default (10) filters out every
                                            // site at this tiny test dataset's read depth
                // Local, not test-datasets: this file's `sample` column has to match
                // this exact test's gathered coverage/mut columns 1:1 (confirmed from a
                // real run: "A04.bullseye.RAC", "E01.bullseye.RAC" - the RAC-filtered
                // edited-sample names), so it's meaningless outside this specific
                // combination of settings and doesn't belong in test-datasets as a
                // general-purpose fixture.
                bullseye_glm_observations = "${projectDir}/tests/bullseye_glm_observations.tsv"

                star_index = null
                fasta      = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genome.fa'
                gtf        = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genes.gtf'
            }
        }

        then {
            def glmTsv = file("$outputDir/bullseye/all_bullseye_sites/all_bullseye_sites.bullseye.glm.tsv")

            // BULLSEYE_GATHER_SITES output - excluded from the content-hash snapshot,
            // but the header shape (5 fixed columns + one per RAC-filtered edited
            // sample) is always guaranteed and confirms the gather step ran correctly.
            def gatherHeaderChecks = ['score', 'coverage', 'mut'].collect { kind ->
                { ->
                    def header = file("$outputDir/bullseye/all_bullseye_sites/all_bullseye_sites.bullseye.${kind}.txt").readLines()[0]
                    def cols = header.tokenize('\t')
                    assert cols[0..4] == ['#chr', 'start', 'end', 'cluster', 'strand'] : "${kind}.txt: unexpected fixed columns: ${cols[0..4]}"
                    assert cols.size() == 7 : "${kind}.txt: expected 5 fixed + 2 sample columns, got ${cols.size()}"
                    assert cols.containsAll(['A04.bullseye.RAC', 'E01.bullseye.RAC']) : "${kind}.txt: missing expected sample columns: ${cols}"
                }
            }

            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Every file produced, content-stable or not - .nftignore only excludes
            // files from the content-hash snapshot (unstable content, e.g. embedded
            // timestamps/tool versions), it doesn't mean they shouldn't be checked
            // at all: catch truncated/empty writes that a hash exclusion would miss.
            // bullseye/*/*.bed excluded: real editing-site detection is data-dependent -
            // a given sample can legitimately have zero sites (e.g. none pass the strict
            // AC-motif filter, or none are detected at all against a given control) in
            // this tiny synthetic test dataset. That's not a pipeline bug, so those files
            // are allowed to be empty here; the gather_sites header shape is still checked
            // (see gatherHeaderChecks above) regardless of row count.
            def emptyFileChecks = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, ignore: ['bullseye/*/*.bed'])
                .collect { f -> { -> assert f.size() > 0 : "Empty output file: ${f}" } }
            assertAll(
                [
                    { assert workflow.success },
                    { assert glmTsv.exists() },
                    // Both real samples here ("A04.bullseye.RAC", "E01.bullseye.RAC") are
                    // from the same "dart" group (see tests/bullseye_glm_observations.tsv) -
                    // the ~group beta-binomial design has no residual degrees of freedom, so
                    // glm_comp_bbn() in Bullseye's functions.R returns NA p-values by design
                    // rather than erroring (same documented limitation as the module's own
                    // real-data fixture). This test exercises the GLM step's wiring and file
                    // handling end-to-end through the full pipeline, not statistical output.
                    { assert glmTsv.readLines().size() > 1 : "Expected a header plus at least one result row" },
                    { assert glmTsv.readLines()[0].tokenize('\t').containsAll(['feature', 'pvalue', 'lfc']) },
                    { assert snapshot(
                        // Number of successful tasks
                        workflow.trace.succeeded().size(),
                        // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                        removeNextflowVersion("$outputDir/pipeline_info/nf_core_dartseq_software_mqc_versions.yml"),
                        // All stable path names, with a relative path
                        stable_name,
                        // All files with stable contents
                        stable_path
                    ).match() }
                ] + gatherHeaderChecks + emptyFileChecks as Closure[]
            )
        }
    }
}
