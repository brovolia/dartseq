nextflow_pipeline {

    name "HISAT2 alignment test"
    script "../main.nf"
    tag "pipeline_hisat2"
    // Also runnable directly: nextflow run . -profile docker,test_hisat2
    // nf-test 0.9.5: this suite-level profile is not reliably applied to
    // nextflow_pipeline tests (see bacmodel/tests/macsyfinder.nf.test for a
    // confirmed case on nf-test 0.9.3), so the params below are kept inline
    // as the source of truth for the actual test run.
    profile "test_hisat2"

    test("HISAT2 alignment") {

        when {
            params {
                outdir = "$outputDir"
                // input comes from conf/test.config (via the "test" profile).
                // Can't reference params.pipelines_testdata_base_path here - this
                // params{} block is evaluated by nf-test itself to build the
                // overrides JSON, before Nextflow has resolved anything from
                // nextflow.config, so it would silently be null.

                trimmer        = 'fastp'
                aligner        = 'hisat2'
                skip_alignment = false
                skip_bullseye  = true

                hisat2_index      = null
                hisat2_splicesites = null
                fasta             = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genome.fa'
                gtf               = 'https://raw.githubusercontent.com/nf-core/test-datasets/dartseq/data/dartseq/reference/genes.gtf'
            }
        }

        then {
            // Check BAM files exist and are non-empty
            def a03_bam = file("$outputDir/hisat2/A03/A03.sorted.bam")
            def a04_bam = file("$outputDir/hisat2/A04/A04.sorted.bam")
            def c03_bam = file("$outputDir/hisat2/C03/C03.sorted.bam")
            def e01_bam = file("$outputDir/hisat2/E01/E01.sorted.bam")
            def a03_bai = file("$outputDir/hisat2/A03/A03.sorted.bam.bai")
            def a04_bai = file("$outputDir/hisat2/A04/A04.sorted.bam.bai")
            def c03_bai = file("$outputDir/hisat2/C03/C03.sorted.bam.bai")
            def e01_bai = file("$outputDir/hisat2/E01/E01.sorted.bam.bai")

            // HISAT2's own alignment-rate summary - excluded from the content-hash
            // snapshot (hisat2/*/*.log in .nftignore, timestamps embedded), but the
            // parseable overall alignment rate confirms alignment actually happened,
            // not just that HISAT2 ran and produced a BAM.
            def hisat2LogChecks = ['A03', 'A04', 'C03', 'E01'].collect { sample ->
                { ->
                    def lines = file("$outputDir/hisat2/${sample}/${sample}.hisat2.summary.log").readLines()
                    def readsLine = lines.find { it.contains('reads; of these') }
                    def rateLine = lines.find { it.contains('overall alignment rate') }
                    def totalReads = readsLine ? (readsLine =~ /^(\d+) reads/)[0][1] as Integer : null
                    assert totalReads != null && totalReads > 0 : "${sample}: no reads reported"
                    assert rateLine != null : "${sample}: overall alignment rate not reported"
                }
            }

            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Every file produced, content-stable or not - .nftignore only excludes
            // files from the content-hash snapshot (unstable content, e.g. embedded
            // timestamps/tool versions), it doesn't mean they shouldn't be checked
            // at all: catch truncated/empty writes that a hash exclusion would miss.
            def emptyFileChecks = getAllFilesFromDir(params.outdir, relative: false, includeDir: false)
                .collect { f -> { -> assert f.size() > 0 : "Empty output file: ${f}" } }
            assertAll(
                [
                    { assert workflow.success },
                    // Verify BAM files exist and have content
                    { assert a03_bam.exists() },
                    { assert a03_bam.size() > 0 },
                    { assert a04_bam.exists() },
                    { assert a04_bam.size() > 0 },
                    { assert c03_bam.exists() },
                    { assert c03_bam.size() > 0 },
                    { assert e01_bam.exists() },
                    { assert e01_bam.size() > 0 },
                    // Verify BAI indices exist
                    { assert a03_bai.exists() },
                    { assert a04_bai.exists() },
                    { assert c03_bai.exists() },
                    { assert e01_bai.exists() },
                    { assert snapshot(
                        // Number of successful tasks
                        workflow.trace.succeeded().size(),
                        // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                        removeNextflowVersion("$outputDir/pipeline_info/nf_core_dartseq_software_mqc_versions.yml"),
                        // All stable path names, with a relative path
                        stable_name,
                        // All files with stable contents
                        stable_path
                    ).match() }
                ] + hisat2LogChecks + emptyFileChecks as Closure[]
            )
        }
    }
}
